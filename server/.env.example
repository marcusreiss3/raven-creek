# Banco PostgreSQL principal
DATABASE_URL=postgres://raven:raven@localhost:5432/ravencreek
# Banco usado pelos testes automatizados (é APAGADO a cada execução)
TEST_DATABASE_URL=postgres://raven:raven@localhost:5432/ravencreek_test
# Opcional: Redis para escalar Socket.IO em várias instâncias (adapter). Sem ele, roda em instância única.
REDIS_URL=
# Segredo do JWT — troque em produção
JWT_SECRET=troque-este-segredo-em-producao
PORT=4000
# Origem do cliente (CORS e cookies)
CLIENT_ORIGIN=http://localhost:5173
# Pasta dos uploads de retratos
UPLOAD_DIR=./uploads
# Intervalo (ms) do tick do mundo: necessidades, ferimentos, viagens, combates, eventos
WORLD_TICK_MS=5000
# Conta administradora criada pelo seed
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=troque-esta-senha
